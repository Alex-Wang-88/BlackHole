#version 430 core

// One invocation traces one camera ray. The output images are the same
// OpenGL textures used by the compositor, so the ray tracer never has to
// copy a frame through CPU memory.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba8, binding = 0) uniform writeonly image2D outputImage;
layout(rgba8, binding = 1) uniform writeonly image2D materialImage;

layout(std430, binding = 0) buffer AccumulationBuffer
{
    vec4 accumulation[];
};

layout(std430, binding = 1) buffer MaterialAccumulationBuffer
{
    vec4 materialAccumulation[];
};

struct GpuObject
{
    vec4 posRadius;
    vec4 color;
    float mass;
    float padding0;
    float padding1;
    float padding2;
    vec4 velocity;
};

layout(std430, binding = 2) readonly buffer ObjectBuffer
{
    GpuObject objects[];
};

uniform vec3 uCameraPos;
uniform vec3 uTarget;
uniform float uFovYRadians;
uniform float uAspect;
uniform uint uRenderWidth;
uniform uint uRenderHeight;
uniform uint uMaxSteps;
uniform float uDLambda;
uniform float uEscapeR;
uniform float uHorizonR;
uniform float uDiskR1;
uniform float uDiskR2;
uniform uint uObjectCount;
uniform uint uSampleIndex;
uniform vec2 uJitter;

struct RayState
{
    vec3 q;
    vec3 v;
    float energy;
};

struct Derivative
{
    vec3 dq;
    vec3 dv;
};

float safeSin(float value)
{
    float result = sin(value);

    if(abs(result) < 1.0e-5)
        return result < 0.0 ? -1.0e-5 : 1.0e-5;

    return result;
}

vec3 rayCartesian(RayState ray)
{
    float radius = ray.q.x;
    float theta = ray.q.y;
    float phi = ray.q.z;

    return vec3(
        radius * sin(theta) * cos(phi),
        radius * sin(theta) * sin(phi),
        radius * cos(theta));
}

bool finiteFloat(float value)
{
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value)
{
    return finiteFloat(value.x) && finiteFloat(value.y) && finiteFloat(value.z);
}

bool interceptDisk(vec3 oldPos, vec3 newPos, out float radiusAtHit)
{
    bool crossed = oldPos.y * newPos.y < 0.0;
    if(!crossed) return false;

    float denominator = newPos.y - oldPos.y;
    if(abs(denominator) < 1.0e-8) return false;

    float crossingT = clamp(-oldPos.y / denominator, 0.0, 1.0);
    vec3 crossingPoint = mix(oldPos, newPos, crossingT);
    float diskRadius = length(vec2(crossingPoint.x, crossingPoint.z));

    if(diskRadius < uDiskR1 || diskRadius > uDiskR2) return false;

    radiusAtHit = diskRadius;
    return true;
}

bool interceptObject(
    vec3 oldPos,
    vec3 newPos,
    out vec4 objectColor,
    out vec3 hitCenter,
    out float hitRadius,
    out vec3 hitPoint)
{
    vec3 segment = newPos - oldPos;
    float a = dot(segment, segment);
    if(a < 1.0e-12) return false;

    bool foundHit = false;
    float closestT = 2.0;

    for(uint objectIndex = 0u; objectIndex < uObjectCount; ++objectIndex)
    {
        vec3 center = objects[objectIndex].posRadius.xyz;
        float radius = objects[objectIndex].posRadius.w;
        vec3 offset = oldPos - center;
        float b = 2.0 * dot(offset, segment);
        float c = dot(offset, offset) - radius * radius;
        float discriminant = b * b - 4.0 * a * c;

        if(discriminant < 0.0) continue;

        float squareRoot = sqrt(discriminant);
        float inverseDenominator = 0.5 / a;
        float nearT = (-b - squareRoot) * inverseDenominator;
        float farT = (-b + squareRoot) * inverseDenominator;
        float candidateT = nearT;

        if(candidateT < 0.0 || candidateT > 1.0) candidateT = farT;
        if(candidateT < 0.0 || candidateT > 1.0 || candidateT >= closestT)
            continue;

        closestT = candidateT;
        objectColor = objects[objectIndex].color;
        hitCenter = center;
        hitRadius = radius;
        hitPoint = oldPos + candidateT * segment;
        foundHit = true;
    }

    return foundHit;
}

RayState makeRay(vec3 position, vec3 direction)
{
    RayState ray;

    float radius = length(position);
    float phi = atan(position.y, position.x);
    float theta = acos(clamp(position.z / radius, -1.0, 1.0));

    float sinTheta = safeSin(theta);
    float cosTheta = cos(theta);
    float sinPhi = sin(phi);
    float cosPhi = cos(phi);

    float dr = dot(position, direction) / radius;
    float dtheta =
        (direction.x * cosTheta * cosPhi +
         direction.y * cosTheta * sinPhi -
         direction.z * sinTheta) / radius;
    float dphi =
        (-direction.x * sinPhi + direction.y * cosPhi) /
        (radius * sinTheta);
    float f = max(1.0 - uHorizonR / radius, 1.0e-5);
    float angular = dtheta * dtheta + sinTheta * sinTheta * dphi * dphi;
    float energySquared = dr * dr + f * radius * radius * angular;

    ray.q = vec3(radius, theta, phi);
    ray.v = vec3(dr, dtheta, dphi);
    ray.energy = sqrt(max(energySquared, 0.0));
    return ray;
}

Derivative geodesicRHS(RayState ray)
{
    Derivative result;

    float radius = max(ray.q.x, uHorizonR * 1.00001);
    float theta = ray.q.y;
    float dr = ray.v.x;
    float dtheta = ray.v.y;
    float dphi = ray.v.z;
    float sinTheta = safeSin(theta);
    float cosTheta = cos(theta);
    float f = max(1.0 - uHorizonR / radius, 1.0e-5);
    float dtDlambda = ray.energy / f;

    result.dq = ray.v;

    float d2r =
        -(uHorizonR / (2.0 * radius * radius)) * f *
            dtDlambda * dtDlambda +
        (uHorizonR / (2.0 * radius * radius * f)) * dr * dr +
        radius * f *
            (dtheta * dtheta + sinTheta * sinTheta * dphi * dphi);
    float d2theta =
        -(2.0 / radius) * dr * dtheta +
        sinTheta * cosTheta * dphi * dphi;
    float d2phi =
        -(2.0 / radius) * dr * dphi -
        2.0 * cosTheta / sinTheta * dtheta * dphi;

    result.dv = vec3(d2r, d2theta, d2phi);
    return result;
}

RayState addState(RayState base, Derivative derivative, float factor)
{
    RayState result = base;
    result.q = base.q + factor * derivative.dq;
    result.v = base.v + factor * derivative.dv;
    return result;
}

void rk4Step(inout RayState ray)
{
    Derivative k1 = geodesicRHS(ray);
    Derivative k2 = geodesicRHS(addState(ray, k1, uDLambda * 0.5));
    Derivative k3 = geodesicRHS(addState(ray, k2, uDLambda * 0.5));
    Derivative k4 = geodesicRHS(addState(ray, k3, uDLambda));

    ray.q += (uDLambda / 6.0) *
        (k1.dq + 2.0 * k2.dq + 2.0 * k3.dq + k4.dq);
    ray.v += (uDLambda / 6.0) *
        (k1.dv + 2.0 * k2.dv + 2.0 * k3.dv + k4.dv);
}

uint packRGBA(vec4 color)
{
    uvec4 channels = uvec4(clamp(color, 0.0, 1.0) * 255.0 + 0.5);
    return channels.r |
           (channels.g << 8u) |
           (channels.b << 16u) |
           (channels.a << 24u);
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if(gid.x >= uRenderWidth || gid.y >= uRenderHeight) return;

    vec3 forward = normalize(uTarget - uCameraPos);
    vec3 worldUp = vec3(0.0, 1.0, 0.0);
    vec3 right = cross(forward, worldUp);

    if(dot(right, right) < 1.0e-8)
        right = vec3(0.0, 0.0, 1.0);
    else
        right = normalize(right);

    vec3 up = normalize(cross(right, forward));
    float tanHalfFov = tan(uFovYRadians * 0.5);
    float sampleX = float(gid.x) + 0.5 + uJitter.x;
    float sampleY = float(gid.y) + 0.5 + uJitter.y;
    float u =
        (2.0 * (sampleX / float(uRenderWidth)) - 1.0) *
        uAspect * tanHalfFov;
    float v =
        (1.0 - 2.0 * (sampleY / float(uRenderHeight))) * tanHalfFov;
    vec3 direction = normalize(u * right + v * up + forward);

    RayState ray = makeRay(uCameraPos, direction);
    bool captured = false;
    bool diskHit = false;
    bool objectHit = false;
    float diskRadiusAtHit = 0.0;
    vec4 objectColor = vec4(0.0);
    vec3 hitCenter = vec3(0.0);
    float hitRadius = 0.0;
    vec3 objectHitPoint = vec3(0.0);

    for(uint step = 0u; step < uMaxSteps; ++step)
    {
        if(ray.q.x <= uHorizonR * 1.01)
        {
            captured = true;
            break;
        }

        if(ray.q.x > uEscapeR && ray.v.x > 0.0) break;

        float previousRadius = ray.q.x;
        vec3 oldPos = rayCartesian(ray);
        rk4Step(ray);

        if(!finiteVec3(ray.q) || !finiteVec3(ray.v))
        {
            if(previousRadius <= uHorizonR * 1.02) captured = true;
            break;
        }

        vec3 newPos = rayCartesian(ray);

        if(interceptObject(
            oldPos,
            newPos,
            objectColor,
            hitCenter,
            hitRadius,
            objectHitPoint))
        {
            objectHit = true;
            break;
        }

        if(interceptDisk(oldPos, newPos, diskRadiusAtHit))
        {
            diskHit = true;
            break;
        }

        if(ray.q.x <= uHorizonR * 1.01)
        {
            captured = true;
            break;
        }
    }

    uint index = gid.y * uRenderWidth + gid.x;
    vec4 currentColor = vec4(0.0);
    vec4 currentMaterial = vec4(0.0);

    if(objectHit)
    {
        vec3 normal = normalize(
            (objectHitPoint - hitCenter) / max(hitRadius, 1.0e-6));
        vec3 lightDirection = normalize(vec3(-0.35, 0.80, 0.48));
        vec3 viewDirection = normalize(uCameraPos - objectHitPoint);
        float diffuse = max(dot(normal, lightDirection), 0.0);
        vec3 reflectedLight = reflect(-lightDirection, normal);
        float specular =
            pow(max(dot(reflectedLight, viewDirection), 0.0), 24.0) * 0.30;
        vec3 shadedColor = clamp(
            objectColor.rgb * (0.22 + 0.78 * diffuse) + specular,
            0.0,
            1.0);
        float objectAlpha = clamp(objectColor.a, 0.0, 1.0);

        currentColor = vec4(shadedColor * objectAlpha, objectAlpha);
        currentMaterial.b = 1.0;
    }
    else if(diskHit)
    {
        float diskT = clamp(
            (diskRadiusAtHit - uDiskR1) / (uDiskR2 - uDiskR1),
            0.0,
            1.0);
        vec3 innerColor = vec3(1.0, 0.15, 0.01);
        vec3 outerColor = vec3(1.0, 0.72, 0.10);
        vec3 diskColor = mix(innerColor, outerColor, diskT);

        currentColor = vec4(diskColor, 1.0);
        currentMaterial.g = 1.0;
    }
    else if(captured)
    {
        currentColor = vec4(0.0, 0.0, 0.0, 1.0);
        currentMaterial.r = 1.0;
    }

    vec4 accumulatedColor = currentColor;
    vec4 accumulatedMaterial = currentMaterial;

    if(uSampleIndex > 0u)
    {
        float sampleWeight = 1.0 / float(uSampleIndex + 1u);
        accumulatedColor = mix(accumulation[index], currentColor, sampleWeight);
        accumulatedMaterial = mix(
            materialAccumulation[index],
            currentMaterial,
            sampleWeight);
    }

    accumulatedColor = clamp(accumulatedColor, 0.0, 1.0);
    accumulatedMaterial = clamp(accumulatedMaterial, 0.0, 1.0);
    accumulation[index] = accumulatedColor;
    materialAccumulation[index] = accumulatedMaterial;

    // The ray coordinates use y=0 as the top row while OpenGL texture
    // coordinates use y=0 at the bottom. Flip once while writing the image.
    ivec2 outputCoord = ivec2(
        int(gid.x),
        int(uRenderHeight - 1u - gid.y));
    imageStore(outputImage, outputCoord, accumulatedColor);
    imageStore(materialImage, outputCoord, accumulatedMaterial);
}
